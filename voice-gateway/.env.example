# Dr. Aria Voice Gateway — Environment Variables

# ── xAI (required) ─────────────────────────────────────────────────
XAI_API_KEY=your-xai-api-key-here
XAI_BASE_URL=https://api.x.ai/v1

# ── LLM ────────────────────────────────────────────────────────────
LLM_MODEL=grok-3-mini
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.7

# ── ASR (Speech-to-Text) ──────────────────────────────────────────
# Leave blank to use xAI STT. Or point to local whisper:
# ASR_BASE_URL=http://localhost:5092/v1
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=

# ── TTS (Text-to-Speech) ──────────────────────────────────────────
XAI_TTS_WS_URL=wss://api.x.ai/v1/tts
TTS_VOICE=luna
TTS_CODEC=alaw
TTS_SAMPLE_RATE=8000
TTS_MODEL=grok-voice-fast-1.0
TTS_OPTIMIZE_LATENCY=1

# ── Telnyx ────────────────────────────────────────────────────────
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_PHONE_NUMBER=+12125551234
TELNYX_WEBHOOK_SECRET=
# Public HTTPS/WSS URL where Telnyx connects for media streaming:
TELNYX_MEDIA_WS_URL=wss://dr-aria.your-domain.com/ws/media
TELNYX_CODEC=PCMA
TELNYX_AUDIO_CHUNK_MS=20

# ── VAD (Voice Activity Detection) ───────────────────────────────
VAD_MODE=2
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=200

# ── Server ────────────────────────────────────────────────────────
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=8765
LOG_LEVEL=info

# ── Soul ──────────────────────────────────────────────────────────
# Path to SOUL.md. Leave blank to use ~/.hermes/SOUL.md or repo default.
SOUL_PATH=
